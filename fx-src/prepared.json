{"crt":{"version":2,"wgsl":"\nstruct U {\n  res: vec2f,\n  time: f32,\n  power: f32,\n  dpr: f32,\n  curvature: f32,\n  scan: f32,\n  glow: f32,\n};\n@group(0) @binding(0) var tex: texture_2d<f32>;\n@group(0) @binding(1) var samp: sampler;\n@group(0) @binding(2) var<uniform> u: U;\n\nfn warp(uv: vec2f) -> vec2f {\n  var c = uv * 2.0 - 1.0;\n  let k = u.curvature * vec2f(1.0 / 16.0, 1.0 / 12.0);\n  c = c * vec2f(1.0 + c.y * c.y * k.x, 1.0 + c.x * c.x * k.y);\n  return c * 0.5 + 0.5;\n}\n\nfn tap(uv: vec2f) -> vec3f {\n  return textureSampleLevel(tex, samp, clamp(uv, vec2f(0.0), vec2f(1.0)), 0.0).rgb;\n}\n\n@fragment fn fs_main(@builtin(position) pos: vec4f, @location(0) uv0: vec2f) -> @location(0) vec4f {\n  // Power-on: a bright line that opens into the picture.\n  let open = smoothstep(0.22, 0.8, u.power);\n  let sx = mix(0.35, 1.0, smoothstep(0.0, 0.25, u.power));\n  let sy = mix(0.006, 1.0, open);\n  let base = uv0;\n  let squeezed = (base - vec2f(0.5)) / vec2f(sx, sy) + vec2f(0.5);\n  let uv = warp(squeezed);\n  let px = 1.0 / u.res;\n  let dir = (uv - vec2f(0.5)) * 0.006;\n  var col = vec3f(tap(uv + dir).r, tap(uv).g, tap(uv - dir).b);\n\n  let r = px * 2.5 * u.dpr;\n  var bloom = tap(uv + vec2f(r.x, 0.0)) + tap(uv - vec2f(r.x, 0.0));\n  bloom += tap(uv + vec2f(0.0, r.y)) + tap(uv - vec2f(0.0, r.y));\n  bloom += tap(uv + r * 1.6) + tap(uv - r * 1.6);\n  bloom += tap(uv + vec2f(r.x, -r.y) * 1.6) + tap(uv + vec2f(-r.x, r.y) * 1.6);\n  bloom = bloom / 8.0;\n  col = col + max(bloom - vec3f(0.55), vec3f(0.0)) * u.glow * 1.2;\n\n  let line = uv.y * u.res.y / (3.0 * u.dpr);\n  let s = 0.5 + 0.5 * cos(6.2831853 * line);\n  col = col * mix(1.0, 0.45 + 0.55 * s, u.scan);\n\n  let m = i32(floor(pos.x / max(1.0, u.dpr))) % 3;\n  var mask = vec3f(1.0 - 0.45 * 0.6);\n  if (m == 0) { mask.r = 1.0; } else if (m == 1) { mask.g = 1.0; } else { mask.b = 1.0; }\n  col = col * mask * (1.0 + 0.6 * 0.3);\n\n  let vc = uv - vec2f(0.5);\n  col = col * (1.0 - dot(vc, vc) * (0.35 + u.curvature * 0.7));\n\n  col = col * mix(5.0, 1.0, smoothstep(0.0, 0.9, u.power));\n  let edge = min(min(uv.x, 1.0 - uv.x) * u.res.x, min(uv.y, 1.0 - uv.y) * u.res.y);\n  let fade = smoothstep(0.0, 4.0 * u.dpr, edge);\n  let inside = select(0.0, 1.0, uv.x >= 0.0 && uv.y >= 0.0 && uv.x <= 1.0 && uv.y <= 1.0);\n  return vec4f(col * fade * inside, 1.0);\n}\n","reflection":{"bindings":[{"group":0,"binding":0,"name":"tex","mangledName":"tex","type":{"kind":"texture","textureKind":"texture_2d","dimension":"2d","sampleType":{"kind":"scalar","name":"f32"}},"kind":"texture","bindingLayout":{"kind":"texture","texture":{"sampleType":"unfilterable-float","viewDimension":"2d","multisampled":false}}},{"group":0,"binding":1,"name":"samp","mangledName":"samp","type":{"kind":"sampler","comparison":false},"kind":"sampler","bindingLayout":{"kind":"sampler","sampler":{"type":"filtering"}}},{"group":0,"binding":2,"name":"u","mangledName":"u","type":{"kind":"identifier","name":"U","mangledName":"_vgsl_6f41d3c0__U"},"kind":"buffer","addressSpace":"uniform","struct":{"name":"U","mangledName":"_vgsl_6f41d3c0__U","members":[{"name":"res","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}}},{"name":"time","type":{"kind":"scalar","name":"f32"}},{"name":"power","type":{"kind":"scalar","name":"f32"}},{"name":"dpr","type":{"kind":"scalar","name":"f32"}},{"name":"curvature","type":{"kind":"scalar","name":"f32"}},{"name":"scan","type":{"kind":"scalar","name":"f32"}},{"name":"glow","type":{"kind":"scalar","name":"f32"}}]},"layout":{"name":"u","mangledName":"u","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"identifier","name":"U","mangledName":"_vgsl_6f41d3c0__U"},"align":8,"size":32,"members":[{"name":"res","offset":0,"align":8,"size":8,"type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}},"layout":{"name":"res","mangledName":"res","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}},"align"