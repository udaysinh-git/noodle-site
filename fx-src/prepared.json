to read.\n  let edge = smoothstep(0.12, 0.62, uv.x) * smoothstep(1.0, 0.85, uv.x)\n    * smoothstep(0.0, 0.25, uv.y) * smoothstep(1.0, 0.75, uv.y);\n  let a = clamp(alpha, 0.0, 1.0) * edge * p.strength;\n  return vec4f(col * edge * p.strength, a);\n}\n","reflection":{"bindings":[{"group":0,"binding":0,"name":"p","mangledName":"p","type":{"kind":"identifier","name":"P","mangledName":"_vgsl_6f41d3c0__P"},"kind":"buffer","addressSpace":"uniform","struct":{"name":"P","mangledName":"_vgsl_6f41d3c0__P","members":[{"name":"res","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}}},{"name":"ptr","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}}},{"name":"time","type":{"kind":"scalar","name":"f32"}},{"name":"pulse","type":{"kind":"scalar","name":"f32"}},{"name":"hover","type":{"kind":"scalar","name":"f32"}},{"name":"strength","type":{"kind":"scalar","name":"f32"}},{"name":"c1","type":{"kind":"vector","width":4,"element":{"kind":"scalar","name":"f32"}}},{"name":"c2","type":{"kind":"vector","width":4,"element":{"kind":"scalar","name":"f32"}}}]},"layout":{"name":"p","mangledName":"p","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"identifier","name":"P","mangledName":"_vgsl_6f41d3c0__P"},"align":16,"size":64,"members":[{"name":"res","offset":0,"align":8,"size":8,"type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}},"layout":{"name":"res","mangledName":"res","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}},"align":8,"size":8}},{"name":"ptr","offset":8,"align":8,"size":8,"type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}},"layout":{"name":"ptr","mangledName":"ptr","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}},"align":8,"size":8}},{"name":"time","offset":16,"align":4,"size":4,"type":{"kind":"scalar","name":"f32"},"layout":{"name":"time","mangledName":